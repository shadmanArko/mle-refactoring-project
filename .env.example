# Copy to .env. Every setting is read by the app (KC_*) or by Docker Compose.

# --- Docker Compose --------------------------------------------------------------
POSTGRES_USER=kc
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=houses
# Host port for the web page and API.
APP_PORT=8000

# --- App -------------------------------------------------------------------------
# Writes (POST/PUT/DELETE) are refused unless a key is set. Choose your own secret.
KC_API_KEY=change-me
# Shown in the web page footer.
# KC_GITHUB_URL=https://github.com/you/your-repo

# --- Running without Docker (uv run uvicorn ...) ---------------------------------
# KC_MODEL_DIR=artifacts
# KC_DATABASE_URL=sqlite:///./houses.db
# For throwaway local experiments only: allow writes without a key.
# KC_OPEN_WRITES=true
