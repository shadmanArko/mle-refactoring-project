# Copy to .env for local runs. Every setting is optional; see api/settings.py.

# Where the trained models live (created by `uv run kc-train`).
KC_MODEL_DIR=artifacts

# SQLite works out of the box. Docker Compose and AWS use Postgres, for example:
# KC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/houses
KC_DATABASE_URL=sqlite:///./houses.db

# Writes (POST/PUT/DELETE) are refused unless a key is set. Choose your own secret.
# KC_API_KEY=change-me
# For throwaway local experiments only:
# KC_OPEN_WRITES=true

# Shown in the web page footer.
KC_GITHUB_URL=
